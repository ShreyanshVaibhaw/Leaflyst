# Copy to a secret-managed location and replace every placeholder.
ABX_IMAGE_TAG=local
ABX_POSTGRES_PASSWORD=replace-with-random-postgres-password
ABX_CH_ADMIN_PASSWORD=replace-with-random-clickhouse-admin-password
ABX_CH_APP_PASSWORD=replace-with-separate-random-app-password
ABX_S3_ACCESS_KEY=replace-with-random-object-store-access-key
ABX_S3_SECRET_KEY=replace-with-random-object-store-secret-key
# Set to the deployment provider's supported encryption mode in production.
ABX_S3_SERVER_SIDE_ENCRYPTION=
ABX_ANCHOR_RETENTION_DAYS=3650
ABX_INGEST_BODY_MAX_BYTES=67108864
ABX_OTLP_BODY_MAX_BYTES=16777216
ABX_ADMIN_KEY=replace-with-at-least-32-random-characters
ABX_GITHUB_STATE_SECRET=replace-with-at-least-32-random-characters
ABX_TENANT_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Optional public fake-data sandbox. Keep disabled until /demo is intentionally public.
ABX_DEMO_ENABLED=false
ABX_PUBLIC_DEMO_MAX_RUNS_PER_HOUR=5
ABX_PUBLIC_DEMO_TTL_HOURS=24
# Optional Google Cloud scan identity. Include the IAM member type prefix.
ABX_GCP_SCANNER_PRINCIPAL=
# Path inside the scanner-worker container when ADC is supplied by a mounted file.
GOOGLE_APPLICATION_CREDENTIALS=
# Required together when ABX_ENV=production. The publishable key is not secret.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ABX_API_PORT=18000
ABX_WEB_PORT=13000
