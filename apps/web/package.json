{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "node e2e/public-smoke.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.16",
    "next": "16.2.11",
    "playwright": "1.60.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "comment": "Ranges, not exact versions. An override keyed on the one version that happened to resolve stops applying the moment a transitive dependency moves, which is how postcss was pinned to 8.5.18 and then 8.5.18 itself became vulnerable. Each key names the vulnerable range from the advisory so the override keeps holding as the tree shifts.",
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "postcss@<8.5.23": "8.5.23",
      "sharp@<0.35.0": "0.35.0"
    }
  }
}
